# Required app access credentials. Use a unique password and a random 32+ character secret.
APP_PASSWORD=
AUTH_SECRET=

# Parking system credentials (server environment values override browser input).
NICEPARK_URL=
NICEPARK_ID=
NICEPARK_PW=
NICEPARK_ALLOWED_HOSTS=

# Web Push: generate once with `npx web-push generate-vapid-keys --json`.
# Set all three in Vercel Production and GitHub Actions secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel cron authorization for the Sunday summary route.
CRON_SECRET=

# Existing Supabase credentials (server key must never be exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
